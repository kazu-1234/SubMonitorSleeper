<Page
    x:Class="SubMonitorSleeper.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:views="using:SubMonitorSleeper.Views"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch">
    <views:PageScrollHost>
        <Grid x:Name="ContentArea">
            <StackPanel Style="{StaticResource PageBaseStackPanelStyle}">
                <TextBlock x:Uid="Page_Settings" Style="{StaticResource PageTitleTextStyle}" />

                <TextBlock x:Uid="Settings_SectionMonitor" Style="{StaticResource SettingsSectionHeaderFirstStyle}" />

                <!-- 対象モニター: 先頭は「自動（メイン以外）」、続いて接続中のモニター -->
                <controls:SettingsCard>
                    <controls:SettingsCard.Header>
                        <TextBlock x:Uid="Settings_TargetMonitor" Style="{StaticResource CardHeaderTextStyle}" />
                    </controls:SettingsCard.Header>
                    <ComboBox x:Name="TargetMonitorComboBox"
                              MinWidth="{StaticResource SettingsComboBoxMinWidth}"
                              SelectionChanged="TargetMonitorComboBox_SelectionChanged" />
                </controls:SettingsCard>

                <!-- 消灯時に D6 へ書く値 -->
                <controls:SettingsCard>
                    <controls:SettingsCard.Header>
                        <TextBlock x:Uid="Settings_PowerOffValue" Style="{StaticResource CardHeaderTextStyle}" />
                    </controls:SettingsCard.Header>
                    <ComboBox x:Name="PowerOffValueComboBox"
                              MinWidth="{StaticResource SettingsComboBoxMinWidth}"
                              SelectionChanged="PowerOffValueComboBox_SelectionChanged" />
                </controls:SettingsCard>

                <!-- ホットキー: ボタンを押すとキー入力の受付状態になる。説明欄は入力中・失敗の表示用 -->
                <controls:SettingsCard>
                    <controls:SettingsCard.Header>
                        <StackPanel Spacing="4" MinWidth="0">
                            <TextBlock x:Uid="Settings_Hotkey" Style="{StaticResource CardHeaderTextStyle}" />
                            <TextBlock x:Name="HotkeyStatusText" Style="{StaticResource CardDescriptionTextStyle}" />
                        </StackPanel>
                    </controls:SettingsCard.Header>
                    <Button x:Name="HotkeyButton"
                            MinWidth="{StaticResource SettingsComboBoxMinWidth}"
                            Click="HotkeyButton_Click"
                            PreviewKeyDown="HotkeyButton_PreviewKeyDown"
                            PreviewKeyUp="HotkeyButton_PreviewKeyUp"
                            LostFocus="HotkeyButton_LostFocus" />
                </controls:SettingsCard>

                <!-- 待ち時間: Windows の「画面をオフにする」時間（読み取り専用） -->
                <controls:SettingsCard>
                    <controls:SettingsCard.Header>
                        <TextBlock x:Uid="Settings_WaitTime" Style="{StaticResource CardHeaderTextStyle}" />
                    </controls:SettingsCard.Header>
                    <TextBlock x:Name="WaitTimeText" VerticalAlignment="Center" />
                </controls:SettingsCard>

                <!-- テスト消灯: D6 で消灯 → 数秒後に自動で点灯（DDC/CI が効くかの確認用）。説明欄には対象モニターを出す -->
                <controls:SettingsCard>
                    <controls:SettingsCard.Header>
                        <StackPanel Spacing="4" MinWidth="0">
                            <TextBlock x:Uid="Settings_TestOff" Style="{StaticResource CardHeaderTextStyle}" />
                            <TextBlock x:Name="TargetMonitorText" Style="{StaticResource CardDescriptionTextStyle}" />
                        </StackPanel>
                    </controls:SettingsCard.Header>
                    <Button x:Name="TestOffButton"
                            x:Uid="Settings_TestOffButton"
                            Click="TestOffButton_Click" />
                </controls:SettingsCard>

                <TextBlock x:Uid="Settings_SectionAppearance" Style="{StaticResource SettingsSectionHeaderStyle}" />

                <controls:SettingsCard>
                    <controls:SettingsCard.Header>
                        <StackPanel Spacing="4" MinWidth="0">
                            <TextBlock x:Uid="Settings_Theme" Style="{StaticResource CardHeaderTextStyle}" />
                            <TextBlock x:Uid="Settings_ThemeDesc" Style="{StaticResource CardDescriptionTextStyle}" />
                        </StackPanel>
                    </controls:SettingsCard.Header>
                    <ComboBox x:Name="ThemeComboBox"
                              Style="{StaticResource CompactComboBoxThemeStyle}"
                              SelectionChanged="ThemeComboBox_SelectionChanged" />
                </controls:SettingsCard>

                <TextBlock x:Uid="Settings_SectionStartup" Style="{StaticResource SettingsSectionHeaderStyle}" />

                <controls:SettingsExpander x:Name="AutoStartExpander"
                                           x:Uid="Settings_AutoStartExpander"
                                           IsExpanded="True">
                    <controls:SettingsExpander.Resources>
                        <Thickness x:Key="SettingsExpanderItemPadding">16,8,16,8</Thickness>
                        <Thickness x:Key="ClickableSettingsExpanderItemPadding">16,8,16,8</Thickness>
                    </controls:SettingsExpander.Resources>
                    <ToggleSwitch x:Name="AutoStartToggle" Toggled="AutoStartToggle_Toggled" />
                    <controls:SettingsExpander.Items>
                        <!-- SPM と同じ: チェック ON = ログオンタスク（既定）/ OFF = スタートアップ（レジストリ Run） -->
                        <controls:SettingsCard>
                            <controls:SettingsCard.Header>
                                <CheckBox x:Name="AutostartTaskOnlyCheckBox"
                                          x:Uid="Settings_AutostartTaskOnly"
                                          VerticalAlignment="Center"
                                          IsChecked="True"
                                          Checked="AutostartTaskOnlyCheckBox_Changed"
                                          Unchecked="AutostartTaskOnlyCheckBox_Changed" />
                            </controls:SettingsCard.Header>
                        </controls:SettingsCard>

                        <controls:SettingsCard>
                            <controls:SettingsCard.Header>
                                <StackPanel Spacing="4" MinWidth="0">
                                    <TextBlock x:Name="AutostartTypeLine" FontSize="13" TextWrapping="Wrap" />
                                    <TextBlock x:Name="AutostartPathLine"
                                               FontSize="13"
                                               TextWrapping="Wrap"
                                               IsTextSelectionEnabled="True" />
                                </StackPanel>
                            </controls:SettingsCard.Header>
                            <Button x:Name="RefreshAutostartButton"
                                    x:Uid="Settings_RefreshAutostart"
                                    Click="RefreshAutostartButton_Click" />
                        </controls:SettingsCard>

                        <controls:SettingsCard>
                            <controls:SettingsCard.Header>
                                <CheckBox x:Name="HideTrayIconCheckBox"
                                          x:Uid="Settings_HideTrayIcon"
                                          VerticalAlignment="Center"
                                          Checked="HideTrayIconCheckBox_Changed"
                                          Unchecked="HideTrayIconCheckBox_Changed" />
                            </controls:SettingsCard.Header>
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>
            </StackPanel>
        </Grid>
    </views:PageScrollHost>
</Page>
